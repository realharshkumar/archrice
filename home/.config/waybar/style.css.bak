@import "colors.css";

* {
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono";
    font-weight: 600;
    border-radius: 0;
    border: none;
    min-height: 0;
    margin: 0;
}

window#waybar {
	min-width: 24px;
    background: alpha(@bg, 0.75);
    color: @fg;
    border: 1px solid @accent;
}

/* Module containers */
.modules-left,
.modules-center,
.modules-right {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

/* Clock */
#clock {
    min-width: 0;
    padding: 16px 0;
    color: @fg;
    font-size: 16px;
    font-weight: 700;
    border-bottom: 1px solid @accent;
}

/* System utility boxes */
#pulseaudio,
#network,
#bluetooth,
#cpu,
#memory,
#backlight,
#battery {
    min-width: 0;
    margin: 2px 3px;
    padding: 7px 0;
    color: @fg;
    background: alpha(@bg, 0.35);
    border: 1px solid @accent;
    border-radius: 0;
    font-size: 14px;
}

/* Battery states */
#battery.charging {
    color: @green;
}

#battery.warning {
    color: @yellow;
}

#battery.critical {
    color: @accent;
}

/* Tray */
#tray {
    padding: 4px 0;
    border-top: 1px solid @accent;
}

/* Power */
#custom-power {
    min-width: 0;
    padding: 8px 0;
    color: @accent;
    font-size: 19px;
    border-top: 1px solid @accent;
}

#custom-power:hover {
    color: @fg;
    background: alpha(@accent, 0.2);
}

#taskbar {
    padding: 6px 0;
}

#taskbar button {
    padding: 6px 0;
    margin: 2px 3px;
    background: transparent;
    border: 1px solid transparent;
}

#taskbar button.active {
    background: alpha(@accent, 0.45);
    border: 1px solid @accent;
}

#taskbar button:hover {
    background: alpha(@accent, 0.2);
}

#custom-power {
    min-width: 0;
    padding: 10px 0;
    color: @accent;
    font-size: 20px;
    border-top: 1px solid @accent;
}

